{
  "expo": {
    "name": "Axis",
    "slug": "axis-app",
    "version": "1.0.0",
    "scheme": "axis",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5C2D91"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.axis.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5C2D91"
      },
      "package": "com.axis.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "sdkVersion": "54.0.0",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Axis needs access to your photo library so you can attach images to your listings.",
          "cameraPermission": "Axis needs access to your camera so you can take photos for your listings.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "70c7989f-96c1-4b70-b9a1-609df41b296e"
      }
    },
    "owner": "ronitttt"
  }
}
