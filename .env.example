# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings → API). Do not commit .env — it is gitignored.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, so restart
# the Expo dev server after changing them. Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry crash reporting. Optional: leave blank and crash reporting no-ops
# (the error boundary still renders). Get the DSN from Sentry → Project
# Settings → Client Keys. It is not a secret — it only authorises writes.
EXPO_PUBLIC_SENTRY_DSN=
